# Credentials
ZWIFT_USERNAME=
ZWIFT_PASSWORD=
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Settings
# Watch start/end differences from the Zwift ride up to this many seconds are left as recorded;
# larger ones are cut (watch ran longer) or filled from Zwift data (watch started late / stopped early)
MAX_TIME_DIFF_SEC=10
# Minimum share of the Zwift ride (in %) the watch recording must cover to be merged
MIN_OVERLAP_PCT=80